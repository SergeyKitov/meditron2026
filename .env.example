# MEDITRON_REPORT_SECRET_PRIVATE=<random-secret>
# MEDITRON_REPORT_SECRET_PACS=<different-random-secret>
# DATABASE_URL=postgresql+psycopg://meditron:meditron_demo_only@127.0.0.1:5432/meditron
