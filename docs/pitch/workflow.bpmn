      <bpmndi:BPMNShape id="visit_complete_di" bpmnElement="visit_complete">
        <dc:Bounds x="465" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_propose_di" bpmnElement="visit_propose">
        <dc:Bounds x="620" y="270" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_manual_di" bpmnElement="visit_manual">
        <dc:Bounds x="620" y="385" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_merge_di" bpmnElement="visit_merge">
        <dc:Bounds x="800" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_send_proposal_di" bpmnElement="visit_send_proposal">
        <dc:Bounds x="910" y="318" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_receive_decision_di" bpmnElement="visit_receive_decision">
        <dc:Bounds x="1070" y="318" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_approved_di" bpmnElement="visit_approved">
        <dc:Bounds x="1230" y="335" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_save_revision_di" bpmnElement="visit_save_revision">
        <dc:Bounds x="1385" y="395" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_publish_di" bpmnElement="visit_publish">
        <dc:Bounds x="1385" y="270" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_notify_di" bpmnElement="visit_notify">
        <dc:Bounds x="1545" y="270" width="110" height="70" />
      </bpmndi:BPMNShape>
