        <dc:Bounds x="1730" y="287" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="visit_c1_di" bpmnElement="visit_c1">
        <di:waypoint x="226" y="353.0" />
