      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="visit_c12_di" bpmnElement="visit_c12">
        <di:waypoint x="1495" y="305.0" />
        <di:waypoint x="1545" y="305.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="visit_c13_di" bpmnElement="visit_c13">
        <di:waypoint x="1655" y="305.0" />
        <di:waypoint x="1730" y="305.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="visit_c14_di" bpmnElement="visit_c14">
        <di:waypoint x="1385" y="430" />
        <di:waypoint x="1340" y="430" />
        <di:waypoint x="1340" y="465" />
        <di:waypoint x="965" y="465" />
        <di:waypoint x="965" y="388" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="visit_proposal_received_di" bpmnElement="visit_proposal_received">
        <dc:Bounds x="900" y="580" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_review_di" bpmnElement="visit_review">
        <dc:Bounds x="1020" y="563" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_review_choice_di" bpmnElement="visit_review_choice">
        <dc:Bounds x="1180" y="580" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_approve_route_di" bpmnElement="visit_approve_route">
        <dc:Bounds x="1325" y="530" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_edit_route_di" bpmnElement="visit_edit_route">
        <dc:Bounds x="1325" y="625" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="visit_review_merge_di" bpmnElement="visit_review_merge">
