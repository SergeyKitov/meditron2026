      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="visit_c8_di" bpmnElement="visit_c8">
        <di:waypoint x="1020" y="353.0" />
        <di:waypoint x="1070" y="353.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="visit_c9_di" bpmnElement="visit_c9">
        <di:waypoint x="1180" y="353.0" />
        <di:waypoint x="1230" y="360.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="visit_c10_di" bpmnElement="visit_c10">
